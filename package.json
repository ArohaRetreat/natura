{
  "name": "natura",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:website": "node scripts/build-website.mjs",
    "test:website": "node --test tests/website.test.mjs tests/field-tour.test.mjs tests/living-motion.test.mjs tests/hero-atmosphere.test.mjs tests/album.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "python3 -m http.server 8770 --directory dist",
    "deploy": "node scripts/deploy-design.mjs",
    "package:assets": "python3 scripts/package-assets.py",
    "package:hrudhi": "node scripts/package-hrudhi.mjs && python3 scripts/zip-hrudhi.py",
    "package:farm": "node scripts/package-farm-atlas.mjs && python3 scripts/zip-farm-atlas.py",
    "test:integration": "node --test functions/tests/integration.mjs"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
