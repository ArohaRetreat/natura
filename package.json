{
  "name": "natura",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "python3 -m http.server 8770 --directory dist",
    "deploy": "node scripts/deploy-design.mjs",
    "package:assets": "python3 scripts/package-assets.py",
    "package:hrudhi": "node scripts/package-hrudhi.mjs && python3 scripts/zip-hrudhi.py",
    "package:farm": "node scripts/package-farm-atlas.mjs && python3 scripts/zip-farm-atlas.py"
  },
  "engines": {
    "node": ">=20"
  }
}
