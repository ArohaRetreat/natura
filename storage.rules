rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function editor() {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/aroha_members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/aroha_members/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/aroha_members/$(request.auth.uid)).data.role in ['superadmin','admin','editor'];
    }
    // Uploaded website media is public immediately; the portal states this before upload.
    match /media/{filename} {
      allow read: if true;
      allow create: if editor() && filename.matches('[a-zA-Z0-9._-]+')
        && ((request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp|avif)'))
          || (request.resource.size < 40 * 1024 * 1024
          && request.resource.contentType.matches('video/(mp4|webm)')));
      allow update, delete: if false; // Immutable URLs keep published revisions intact.
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
