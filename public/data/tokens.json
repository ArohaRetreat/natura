{
  "version": "2.0.0",
  "color": {
    "forest": "#163E2D",
    "leaf": "#60833D",
    "bronze": "#86613B",
    "ivory": "#FAF7EF",
    "mist": "#DDE5D7",
    "white": "#FFFFFF"
  },
  "font": {
    "display.en": "Lora",
    "body.en": "Source Sans 3",
    "display.kn": "Noto Serif Kannada",
    "body.kn": "Noto Sans Kannada"
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "type": {
    "display": {
      "size": 56,
      "line": 64,
      "weight": 500
    },
    "h1": {
      "size": 40,
      "line": 48,
      "weight": 500
    },
    "h2": {
      "size": 32,
      "line": 40,
      "weight": 500
    },
    "h3": {
      "size": 24,
      "line": 32,
      "weight": 600
    },
    "body": {
      "size": 18,
      "line": 28,
      "weight": 400
    },
    "bodySmall": {
      "size": 16,
      "line": 24,
      "weight": 400
    },
    "label": {
      "size": 16,
      "line": 24,
      "weight": 600
    },
    "caption": {
      "size": 14,
      "line": 20,
      "weight": 400
    }
  },
  "motion": {
    "durationMs": 180,
    "easing": "cubic-bezier(0.23,1,0.32,1)",
    "reducedMotion": "disable nonessential transitions"
  },
  "interaction": {
    "minTargetPx": 48,
    "focusRingPx": 3
  },
  "surface": {
    "default": "#FFFFFF",
    "warmOptional": "#FAF7EF",
    "icon": "transparent"
  },
  "natureMotion": {
    "leafSettle": {
      "purpose": "Spatial consistency / occasional content entrance",
      "durationMs": 240,
      "easing": "cubic-bezier(0.23,1,0.32,1)",
      "from": "translateY(-8px) rotate(-2deg)",
      "to": "translateY(0) rotate(0deg)",
      "opacity": [
        0,
        1
      ]
    },
    "seedUnfold": {
      "purpose": "State indication / occasional card or section reveal",
      "durationMs": 240,
      "easing": "cubic-bezier(0.23,1,0.32,1)",
      "from": "translateY(6px) scale(0.96)",
      "to": "translateY(0) scale(1)",
      "origin": "50% 100%",
      "opacity": [
        0,
        1
      ]
    },
    "waterResponse": {
      "purpose": "Pointer press feedback",
      "pressDurationMs": 140,
      "ringDurationMs": 220,
      "easing": "cubic-bezier(0.23,1,0.32,1)",
      "pressScale": 0.98,
      "ringScale": [
        0.95,
        1.6
      ],
      "opacity": [
        0.55,
        0
      ]
    },
    "pathReveal": {
      "purpose": "State indication / reveal a short journey or next step",
      "durationMs": 200,
      "staggerMs": 30,
      "easing": "cubic-bezier(0.23,1,0.32,1)",
      "from": "translateX(-6px)",
      "to": "translateX(0)",
      "opacity": [
        0,
        1
      ]
    },
    "policy": {
      "autoplay": false,
      "loop": false,
      "maxConcurrentPreviews": 1,
      "keyboard": "Instant final state",
      "reducedMotion": "Optional opacity-only 150ms; no movement",
      "hiddenTab": "Cancel owned animations",
      "production": "Reading content, form keystrokes and high-frequency navigation stay still"
    }
  }
}